<Application x:Class="R5BatteryEstimator.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#E53935" />
    <SolidColorBrush x:Key="Surface" Color="#202124" />
    <SolidColorBrush x:Key="Card" Color="#2B2D31" />
    <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="18,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Application.Resources>
</Application>
