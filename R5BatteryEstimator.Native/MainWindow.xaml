<Window x:Class="R5BatteryEstimator.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="R5 Battery Estimator" Height="480" Width="720" ResizeMode="NoResize" Background="#202124" Foreground="White" WindowStartupLocation="CenterScreen">
  <Grid Margin="36">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0"><TextBlock Text="R5 Battery Estimator" FontSize="24" FontWeight="Bold"/><Border Background="#E53935" CornerRadius="10" Padding="9,3" Margin="12,4,0,0" DockPanel.Dock="Right"><TextBlock Text="R5 ULTRA" FontSize="11" FontWeight="Bold"/></Border></DockPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock Text="BATERÍA ACTUAL" Foreground="#B7BBC5" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock x:Name="PercentText" Text="—%" FontSize="92" FontWeight="Bold" Margin="0,4,0,0"/>
      <TextBlock x:Name="StatusText" Text="Leyendo el receptor…" Foreground="#B7BBC5" FontSize="16"/>
      <ProgressBar x:Name="BatteryBar" Height="9" Margin="0,24,0,24" Minimum="0" Maximum="100" Value="0" Foreground="#E53935" Background="#46484D"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2B2D31" CornerRadius="9" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="AUTONOMÍA ESTIMADA" Foreground="#B7BBC5" FontSize="12"/><TextBlock x:Name="EstimateText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Provisional; se calibrará con tu uso." Foreground="#B7BBC5" FontSize="12"/></StackPanel></Border>
        <Border Grid.Column="1" Background="#2B2D31" CornerRadius="9" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="ÚLTIMA LECTURA" Foreground="#B7BBC5" FontSize="12"/><TextBlock x:Name="UpdatedText" Text="Sin datos" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Actualiza cada 30 segundos." Foreground="#B7BBC5" FontSize="12"/></StackPanel></Border>
      </Grid>
    </StackPanel>
    <DockPanel Grid.Row="2"><TextBlock Text="No se muestra una desconexión como 0%." Foreground="#B7BBC5" VerticalAlignment="Center"/><Button Content="Actualizar ahora" Click="Refresh_Click" DockPanel.Dock="Right"/></DockPanel>
  </Grid>
</Window>
